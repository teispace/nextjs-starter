NEXT_PUBLIC_API_URL=
# Public URL this app is served from. Required by production builds
# (`build`, `validate`), so the example ships a working local value. -public
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Origin the server uses to reach the API when it differs from the public one
# (a private network name inside Docker or Kubernetes). Optional.
API_INTERNAL_URL=

# Build the self-contained `.next/standalone` server. The Dockerfile turns this
# on; leave it off for `next start` and platform hosts (Vercel, Netlify).
BUILD_STANDALONE=

# Content Security Policy: static (default, prerender-friendly) | nonce (strict,
# every page renders per request) | off.
CSP_MODE=

# @next-maker:i18n:start
# IANA time zone for server-rendered date/number formatting (default: UTC).
# Keeps SSR output deterministic across regions and silences next-intl's
# ENVIRONMENT_FALLBACK warning.
DEFAULT_TIMEZONE=

# Fallback locale when a request locale cannot be resolved (default: en).
DEFAULT_LOCALE=
# @next-maker:i18n:end

PORT=3000 # -public

# @next-maker:docker:start
# Docker Compose Configuration
CONTAINER_NAME=next-app # -public
IMAGE_NAME=nextjs-starter # -public
IMAGE_TAG=latest # -public
# @next-maker:docker:end
