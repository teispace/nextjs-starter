{
  "name": "teispace",
  "version": "0.1.5",
  "description": "A production-ready Next.js starter template with TypeScript, Tailwind CSS, Redux Toolkit, and more.",
  "keywords": [
    "nextjs",
    "react",
    "typescript",
    "tailwindcss",
    "starter",
    "template",
    "redux"
  ],
  "author": "Teispace",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/teispace/nextjs-starter/issues"
  },
  "homepage": "https://github.com/teispace/nextjs-starter#readme",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/teispace/nextjs-starter.git"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "analyze": "ANALYZE=true next build",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "format": "biome format --write",
    "format:check": "biome format",
    "ci:check": "biome ci",
    "lint-staged": "lint-staged",
    "env:sync": "tsx scripts/sync-env.ts",
    "check:deprecated": "tsx scripts/check-deprecated.ts",
    "type-check": "tsc --noEmit",
    "prepare": "husky",
    "commit": "cz",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "validate": "yarn ci:check && yarn type-check && yarn check:deprecated && yarn test && yarn build"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.12.0",
    "@teispace/next-themes": "^0.5.0",
    "axios": "^1.16.1",
    "next": "^16.2.6",
    "next-intl": "^4.12.0",
    "pino": "^10.3.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-redux": "^9.3.0",
    "react-secure-storage": "^1.3.2",
    "redux": "^5.0.1",
    "redux-persist": "^6.0.0",
    "server-only": "^0.0.1",
    "socket.io-client": "^4.8.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@commitlint/cli": "^21.0.1",
    "@commitlint/config-conventional": "^21.0.1",
    "@next/bundle-analyzer": "^16.2.6",
    "@tailwindcss/postcss": "^4.3.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "babel-plugin-react-compiler": "^1.0.0",
    "commitizen": "^4.3.1",
    "cz-conventional-changelog": "^3.3.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.0.5",
    "pino-pretty": "^13.1.3",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  }
}
