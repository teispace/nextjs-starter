{
  "name": "teispace",
  "version": "0.1.5",
  "description": "A production-ready Next.js starter template with TypeScript, Tailwind CSS, Redux Toolkit, and more.",
  "keywords": [
    "nextjs",
    "react",
    "typescript",
    "tailwindcss",
    "starter",
    "template",
    "redux"
  ],
  "author": "Teispace",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/teispace/nextjs-starter/issues"
  },
  "homepage": "https://github.com/teispace/nextjs-starter#readme",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/teispace/nextjs-starter.git"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "format": "biome format --write",
    "format:check": "biome format",
    "ci:check": "biome ci",
    "lint-staged": "lint-staged",
    "env:sync": "tsx scripts/sync-env.ts",
    "type-check": "tsc --noEmit",
    "prepare": "husky",
    "commit": "cz",
    "test": "echo \"Skipping tests: no test framework configured yet\"",
    "validate": "yarn ci:check && yarn type-check && yarn build"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.11.2",
    "@teispace/next-themes": "^0.2.0",
    "axios": "^1.15.2",
    "next": "^16.2.4",
    "next-intl": "^4.9.1",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-redux": "^9.2.0",
    "react-secure-storage": "^1.3.2",
    "redux": "^5.0.1",
    "redux-persist": "^6.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.13",
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@tailwindcss/postcss": "^4.2.4",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "babel-plugin-react-compiler": "^1.0.0",
    "commitizen": "^4.3.1",
    "cz-conventional-changelog": "^3.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "tailwindcss": "^4.2.4",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3"
  }
}
