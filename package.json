{
  "name": "teispace",
  "version": "2.0.0-alpha.0",
  "description": "A production-ready Next.js starter template with TypeScript, Tailwind CSS, Redux Toolkit, and more.",
  "keywords": [
    "nextjs",
    "react",
    "typescript",
    "tailwindcss",
    "starter",
    "template",
    "redux"
  ],
  "author": "Teispace",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/teispace/nextjs-starter/issues"
  },
  "homepage": "https://github.com/teispace/nextjs-starter#readme",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/teispace/nextjs-starter.git"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "analyze": "ANALYZE=true next build",
    "typegen": "node scripts/typegen.ts",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "format": "biome format --write",
    "format:check": "biome format",
    "ci:check": "biome ci",
    "lint-staged": "lint-staged",
    "env:sync": "node scripts/sync-env.ts",
    "check:deprecated": "node scripts/check-deprecated.ts",
    "type-check": "pnpm typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "validate": "pnpm ci:check && pnpm type-check && pnpm check:deprecated && pnpm test && pnpm build",
    "prepare": "husky",
    "commit": "cz",
    "icons": "node scripts/generate-icons.ts",
    "api:types": "node scripts/openapi-types.ts"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.12.0",
    "@tanstack/react-query": "^5.102.8",
    "@teispace/env": "^1.0.0",
    "@teispace/next-themes": "^3.0.0",
    "axios": "^1.20.0",
    "next": "^16.3.4",
    "next-intl": "^4.14.2",
    "next-safe-action": "^8.7.1",
    "pino": "^10.3.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-redux": "^9.3.0",
    "redux": "^5.0.1",
    "server-only": "^0.0.1",
    "socket.io-client": "^4.8.3",
    "zod": "^4.5.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@next/bundle-analyzer": "^16.3.4",
    "@next/playwright": "^16.3.4",
    "@playwright/test": "^1.62.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@typescript/typescript6": "^6.0.2",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "commitizen": "^4.3.2",
    "cz-conventional-changelog": "^3.3.0",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.4.0",
    "msw": "^2.15.0",
    "openapi-typescript": "^7.13.0",
    "pino-pretty": "^13.1.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0"
  }
}
