#!/usr/bin/env sh

echo '🚦 Running pre-push validation...'

# 1. Biome lint + format check
echo '🧹 Lint & format...'
yarn ci:check
if [ $? -ne 0 ]; then
    echo '❌ Lint/format check failed. Run "yarn lint:fix" and try again.'
    exit 1
fi

# 2. TypeScript
echo '🔎 Type checking...'
yarn type-check
if [ $? -ne 0 ]; then
    echo '❌ Type check failed. Fix TypeScript errors before pushing.'
    exit 1
fi

# 3. Deprecated API usage
echo '🚫 Checking for deprecated APIs...'
yarn check:deprecated
if [ $? -ne 0 ]; then
    echo '❌ Deprecated API usage detected. Replace before pushing.'
    exit 1
fi

# 4. Unit tests
echo '🧪 Running tests...'
yarn test
if [ $? -ne 0 ]; then
    echo '❌ Tests failed. Fix before pushing.'
    exit 1
fi

echo '✅ Pre-push validation passed. CI will run the production build.'
